<Project>
  <PropertyGroup>
    <!-- Включаем центральное управление версиями -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Транзитивные зависимости тоже закрепляются -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup>
    <!-- Logger -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.9"/>
    
    <!-- Валидация -->
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1"/>
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4"/>
    
    <!-- HTTP / OpenAPI -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.9" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.3" />
    <PackageVersion Include="Microsoft.OpenApi" Version="2.9.0" />

    <!-- Анализаторы (версии здесь, подключение в Directory.Build.props) -->
    <PackageVersion Include="Roslynator.Analyzers" Version="4.15.0" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.104" />
    <PackageVersion Include="AsyncFixer" Version="2.1.0" />
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.27.0.140913" />

    <!-- DatabaseTools -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.2" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.9" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>
</Project>